    items: [
      "GitHub Actions",
      "Docker",
      "Git",
      "Supabase",
      "Vercel",
      "MetaTrader 5 integrations",
    ],
  },
];
const projects = [
  {
    name: "FillWire",
    type: "Trading technology · Product",
    description:
      "A trading strategy execution platform in development, focused on two workflows: automated strategy execution and professional trader-led trade distribution to connected customer accounts.",
    tags: ["Product strategy", "Trading systems", "SaaS"],
    link: "https://fillwire.com",
    label: "Visit FillWire",
  },
  {
    name: "Toastlytics",
    type: "SaaS · Analytics",
    description:
      "A trading journal and analytics product focused on trade reviews, behavioural patterns, risk intelligence, and helping traders examine what happens after an entry.",
