      "User feedback loops",
      "Developer relations",
      "Technical documentation",
      "Training & onboarding",
    ],
  },
  {
    group: "Engineering",
    items: [
      "Astro",
      "Flutter",
      "Kotlin",
      "Jetpack Compose",
      "Java",
      "Spring Boot",
      "Go",
      "Python",
      "SQL",
    ],
  },
  {
